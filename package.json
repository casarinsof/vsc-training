{
  "name": "vsc-training",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,mobile -c green,cyan \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:web": "npm run dev --workspace=@vsc-training/web",
    "dev:mobile": "npm run start --workspace=@vsc-training/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "@expo/vector-icons": "15.0.3",
    "expo-font": "14.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}